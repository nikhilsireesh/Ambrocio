# Public URL of the deployed site (used for canonical URLs, Open Graph and structured data)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where estimate requests are delivered. Any endpoint that accepts a JSON POST works
# (Formspree, Zapier/Make webhook, Slack incoming webhook, your own CRM, etc.).
# If this is not set, the form tells visitors to text or call Eduardo instead.
ESTIMATE_WEBHOOK_URL=
